<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Retro Football Sim</title>
    <style>
        /* Reset and Retro Game Theme */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
        }

        body {
            background-color: #121212;
            color: #e0e0e0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .game-container {
            width: 100%;
            max-width: 600px;
            background-color: #1e1e1e;
            border: 4px solid #333;
            border-radius: 8px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.6);
            padding: 20px;
        }

        /* Scoreboard */
        .scoreboard {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #0b2d19;
            border: 2px solid #2e7d32;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .team {
            text-align: center;
        }

        .team h2 {
            font-size: 1rem;
            color: #a5d6a7;
            margin-bottom: 5px;
        }

        .score-display {
            font-size: 2rem;
            font-weight: bold;
            color: #fff;
            background: #000;
            padding: 5px 15px;
            border-radius: 4px;
            border: 1px solid #444;
        }

        .game-info {
            text-align: center;
            font-size: 0.9rem;
            color: #c8e6c9;
        }

        .game-info div {
            margin: 2px 0;
        }

        /* Strategy Panel */
        .strategy-panel {
            background-color: #262626;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            border: 1px solid #444;
        }

        .strategy-panel h3 {
            font-size: 1.1rem;
            margin-bottom: 10px;
            color: #ffb300;
        }

        .toggle-group {
            margin-bottom: 15px;
        }

        .toggle-group label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

        select {
            width: 100%;
            padding: 8px;
            background-color: #333;
            color: #fff;
            border: 1px solid #555;
            border-radius: 4px;
            font-size: 0.9rem;
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: #d32f2f;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
        }

        button:hover {
            background-color: #b71c1c;
        }

        /* Broadcast Window */
        .broadcast-window {
            background-color: #181818;
            padding: 15px;
            border-radius: 6px;
            border: 1px solid #444;
        }

        .broadcast-window h3 {
            font-size: 1.1rem;
            margin-bottom: 10px;
            color: #90caf9;
        }

        .ticker-box {
            background-color: #000;
            border: 1px solid #333;
            padding: 12px;
            border-radius: 4px;
            min-height: 60px;
        }

        .announcer-text {
            font-size: 0.95rem;
            color: #81c784;
            line-height: 1.4;
        }
    </style>
</head>
<body>

    <div class="game-container">
        <!-- SCOREBOARD (Joe Montana Vibe) -->
        <header class="scoreboard">
            <div class="team home">
                <h2>HOME</h2>
                <div id="home-score" class="score-display">00</div>
            </div>
            <div class="game-info">
                <div id="quarter">Q1</div>
                <div id="down-distance">1st & 10</div>
                <div id="ball-on">Own 20</div>
            </div>
            <div class="team away">
                <h2>AWAY</h2>
                <div id="away-score" class="score-display">00</div>
            </div>
        </header>

        <!-- STRATEGY PANEL (Troy Aikman Logic toggles) -->
        <section class="strategy-panel">
            <h3>Playbook Strategy</h3>
            <div class="toggle-group">
                <label for="play-call">Next Offensive Scheme:</label>
                <select id="play-call">
                    <option value="triple-option">Bill Walsh Triple Option (Heavy Run)</option>
                    <option value="west-coast">West Coast Short Pass (Balanced)</option>
                    <option value="run-and-shoot">Run & Shoot Deep Pass (Aggressive)</option>
                </select>
            </div>
            <button id="sim-button">Snap the Ball</button>
        </section>

        <!-- LIVE TICKER BROADCAST (Joe Montana Announcer) -->
        <main class="broadcast-window">
            <h3>Live Radio Broadcast</h3>
            <div id="ticker-box" class="ticker-box">
                <p class="announcer-text">Welcome to the stadium! Set your playbook strategy above and snap the ball to kick off.</p>
            </div>
        </main>
    </div>

</body>
</html>
